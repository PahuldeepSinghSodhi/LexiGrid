  m_text: "<b>Swipe adjacent letters</b> to form words.\n\nWords must be <b>3+ letters</b>
    long.\n\n<b>Scoring:</b>\n  3 letters = 100 pts\n  4 letters = 400 pts\n  5 letters
    = 800 pts\n  6 letters = 1,200 pts\n  7+ letters = 2,000 pts\n\n<b>Speed Bonus:</b>\n 
    Under 5 sec = 1.5\xD7 multiplier\n  Under 10 sec = 1.25\xD7 multiplier\n\nEach
    word can only be scored <b>once</b> per round.\n\nGreen tiles = valid prefix\nRed
    tiles = invalid prefix"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
